; Decorated Glide 2.x stdcall export names (_grXxx@N), aliased to the
; plain Rust symbols. Glide2 games import these decorated names; the
; undecorated names remain exported by Rust for the test harnesses.
EXPORTS
    _grAlphaBlendFunction@16 = grAlphaBlendFunction
    _grAlphaCombine@20 = grAlphaCombine
    _grAlphaControlsITRGBLighting@4 = grAlphaControlsITRGBLighting
    _grAlphaTestFunction@4 = grAlphaTestFunction
    _grAlphaTestReferenceValue@4 = grAlphaTestReferenceValue
    _grBufferClear@12 = grBufferClear
    _grBufferNumPending@0 = grBufferNumPending
    _grBufferSwap@4 = grBufferSwap
    _grChromakeyMode@4 = grChromakeyMode
    _grChromakeyValue@4 = grChromakeyValue
    _grClipWindow@16 = grClipWindow
    _grColorCombine@20 = grColorCombine
    _grColorMask@8 = grColorMask
    _grConstantColorValue@4 = grConstantColorValue
    _grCullMode@4 = grCullMode
    _grDepthBiasLevel@4 = grDepthBiasLevel
    _grDepthBufferFunction@4 = grDepthBufferFunction
    _grDepthBufferMode@4 = grDepthBufferMode
    _grDepthMask@4 = grDepthMask
    _grDitherMode@4 = grDitherMode
    _grDrawLine@8 = grDrawLine
    _grDrawPlanarPolygonVertexList@8 = grDrawPlanarPolygonVertexList
    _grDrawPolygonVertexList@8 = grDrawPolygonVertexList
    _grDrawTriangle@12 = grDrawTriangle
    _grErrorSetCallback@4 = grErrorSetCallback
    _grFogColorValue@4 = grFogColorValue
    _grFogMode@4 = grFogMode
    _grFogTable@4 = grFogTable
    _grGammaCorrectionValue@4 = grGammaCorrectionValue
    _grGlideGetVersion@4 = grGlideGetVersion
    _grGlideInit@0 = grGlideInit
    _grGlideShutdown@0 = grGlideShutdown
    _grHints@8 = grHints
    _grLfbLock@24 = grLfbLock
    _grLfbReadRegion@28 = grLfbReadRegion
    _grLfbUnlock@8 = grLfbUnlock
    _grLfbWriteRegion@32 = grLfbWriteRegion
    _grSstControl@4 = grSstControl
    _grSstQueryBoards@4 = grSstQueryBoards
    _grSstQueryHardware@4 = grSstQueryHardware
    _grSstScreenHeight@0 = grSstScreenHeight
    _grSstScreenWidth@0 = grSstScreenWidth
    _grSstSelect@4 = grSstSelect
    _grSstWinClose@0 = grSstWinClose
    _grSstWinOpen@28 = grSstWinOpen
    _grTexCalcMemRequired@16 = grTexCalcMemRequired
    _grTexClampMode@12 = grTexClampMode
    _grTexCombine@28 = grTexCombine

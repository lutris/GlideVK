    _grTexDownloadMipMap@16 = grTexDownloadMipMap
    _grTexDownloadMipMapLevel@32 = grTexDownloadMipMapLevel
    _grTexDownloadMipMapLevelPartial@40 = grTexDownloadMipMapLevelPartial
    _grTexDownloadTable@12 = grTexDownloadTable
    _grTexFilterMode@12 = grTexFilterMode
    _grTexLodBiasValue@8 = grTexLodBiasValue
    _grTexMaxAddress@4 = grTexMaxAddress
    _grTexMinAddress@4 = grTexMinAddress
    _grTexMipMapMode@12 = grTexMipMapMode
    _grTexSource@16 = grTexSource
    _guAlphaSource@4 = guAlphaSource
    _guColorCombineFunction@4 = guColorCombineFunction
    _guFogTableIndexToW@4 = guFogTableIndexToW
    _guTexCombineFunction@8 = guTexCombineFunction
